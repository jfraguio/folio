{
  "name": "folio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Un bloc de notas persistente y silencioso.",
  "scripts": {
    "dict": "node scripts/copy-dictionaries.mjs",
    "icons": "node scripts/icons.mjs",
    "predev": "npm run dict",
    "dev": "vite",
    "prebuild": "npm run dict",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/commands": "^6.6.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.33.0",
    "dictionary-es": "^4.0.0",
    "idb": "^8.0.0",
    "nspell": "^2.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/nspell": "^2.1.0",
    "@types/wicg-file-system-access": "^2023.10.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.0.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
