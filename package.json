{
  "name": "folio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Un lugar para escribir novelas sin distracciones.",
  "scripts": {
    "dict": "node scripts/copy-dictionaries.mjs",
    "predev": "npm run dict",
    "dev": "vite",
    "prebuild": "npm run dict",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.33.0",
    "@lezer/highlight": "^1.2.0",
    "dictionary-es": "^4.0.0",
    "idb": "^8.0.0",
    "nspell": "^2.1.5",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/mdast": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/nspell": "^2.1.0",
    "@types/wicg-file-system-access": "^2023.10.5",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.0"
  }
}
